rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function sessionPath(sessionId) {
      return /databases/$(database)/documents/sessions/$(sessionId);
    }

    function isValidSession(sessionId) {
      return sessionId is string
        && exists(sessionPath(sessionId))
        && get(sessionPath(sessionId)).data.expiresAt > request.time;
    }

    function isAdminSession(sessionId) {
      return isValidSession(sessionId)
        && get(sessionPath(sessionId)).data.role == 'admin';
    }

    function isFacultySession(sessionId) {
      return isValidSession(sessionId)
        && get(sessionPath(sessionId)).data.role == 'faculty_coordinator';
    }

    function facultyDepartment(sessionId) {
      return get(sessionPath(sessionId)).data.department;
    }

    function isSelfPasswordUpdate(userId) {
      return isValidSession(request.resource.data._sessionId)
        && get(sessionPath(request.resource.data._sessionId)).data.userId == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['passwordHash', 'salt', 'mustChangePassword', 'passwordChangedAt', 'updatedAt', '_sessionId']);
    }

    function isFacultyVolunteerCreate() {
      return isFacultySession(request.resource.data._sessionId)
        && request.resource.data.role == 'student_volunteer'
        && request.resource.data.department == facultyDepartment(request.resource.data._sessionId)
        && request.resource.data.keys().hasAll(['passwordHash', 'salt', 'username', 'role', 'department', 'team']);
    }

    function isFacultyVolunteerUpdate(userId) {
      return isFacultySession(request.resource.data._sessionId)
        && resource.data.role == 'student_volunteer'
        && resource.data.department == facultyDepartment(request.resource.data._sessionId)
        && request.resource.data.role == 'student_volunteer'
        && request.resource.data.department == resource.data.department;
    }

    match /alumni/{docId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'batch', 'department'])
                    && request.resource.data.fullName is string
                    && request.resource.data.email is string
                    && request.resource.data.batch is string
                    && request.resource.data.department is string;
      allow update: if isAdminSession(request.resource.data._sessionId);
      allow delete: if false;
    }

    match /institutional_users/{userId} {
      allow get: if true;
      allow list: if false;
      allow create: if (userId == 'gecian_at_admin'
                        && request.resource.data.role == 'admin'
                        && request.resource.data.keys().hasAll(['passwordHash', 'salt', 'username']))
                    || isAdminSession(request.resource.data._sessionId)
                    || isFacultyVolunteerCreate();
      allow update: if isAdminSession(request.resource.data._sessionId)
                    || isSelfPasswordUpdate(userId)
                    || isFacultyVolunteerUpdate(userId);
      allow delete: if false;
    }

    match /institutional_users/_registry {
      allow read: if true;
      allow create, update: if isAdminSession(request.resource.data._sessionId)
                            || isFacultySession(request.resource.data._sessionId);
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow create: if request.resource.data.keys().hasAll(['userId', 'username', 'role', 'expiresAt'])
                    && request.resource.data.expiresAt > request.time
                    && exists(/databases/$(database)/documents/institutional_users/$(request.resource.data.userId))
                    && get(/databases/$(database)/documents/institutional_users/$(request.resource.data.userId)).data.role == request.resource.data.role
                    && get(/databases/$(database)/documents/institutional_users/$(request.resource.data.userId)).data.active != false;
      allow get: if true;
      allow list: if false;
      allow delete: if true;
      allow update: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAdminSession(request.resource.data._sessionId);
      allow delete: if false;
    }

    match /pre_events/{eventId} {
      allow read: if true;
      allow create, update: if isAdminSession(request.resource.data._sessionId);
      allow delete: if false;
    }

    match /main_tasks/{taskId} {
      allow read: if true;
      allow create, update: if isAdminSession(request.resource.data._sessionId);
      allow delete: if false;
    }

    match /dept_tasks/{taskId} {
      allow read: if true;
      allow create, update: if isAdminSession(request.resource.data._sessionId)
                            || (isValidSession(request.resource.data._sessionId)
                                && get(sessionPath(request.resource.data._sessionId)).data.role == 'faculty_coordinator'
                                && get(sessionPath(request.resource.data._sessionId)).data.department == request.resource.data.department);
      allow delete: if false;
    }

    function isTreasurerSession(sessionId) {
      return isValidSession(sessionId)
        && get(sessionPath(sessionId)).data.role == 'treasurer';
    }

    function isAccountsWriter(sessionId) {
      return isAdminSession(sessionId) || isTreasurerSession(sessionId);
    }

    match /alumni_contacts/{contactId} {
      allow read: if true;
      allow create: if isAdminSession(request.resource.data._sessionId)
                    || isTreasurerSession(request.resource.data._sessionId)
                    || (isFacultySession(request.resource.data._sessionId)
                        && request.resource.data.department == facultyDepartment(request.resource.data._sessionId))
                    || (isValidSession(request.resource.data._sessionId)
                        && get(sessionPath(request.resource.data._sessionId)).data.role == 'student_volunteer'
                        && request.resource.data.createdByUserId == get(sessionPath(request.resource.data._sessionId)).data.userId
                        && request.resource.data.keys().hasAll(['alumniName', 'whatsapp', 'department', 'deptTaskId', 'createdByUserId']));
      allow update: if isAdminSession(request.resource.data._sessionId)
                    || isTreasurerSession(request.resource.data._sessionId)
                    || (isFacultySession(request.resource.data._sessionId)
                        && resource.data.department == facultyDepartment(request.resource.data._sessionId)
                        && request.resource.data.department == resource.data.department)
                    || (isValidSession(request.resource.data._sessionId)
                        && get(sessionPath(request.resource.data._sessionId)).data.role == 'student_volunteer'
                        && resource.data.createdByUserId == get(sessionPath(request.resource.data._sessionId)).data.userId
                        && request.resource.data.createdByUserId == resource.data.createdByUserId);
      allow delete: if false;
    }

    match /volunteer_certificate_batches/{batchId} {
      allow read: if true;
      allow create: if isAdminSession(request.resource.data._sessionId)
                    || (isFacultySession(request.resource.data._sessionId)
                        && request.resource.data.department == facultyDepartment(request.resource.data._sessionId)
                        && request.resource.data.keys().hasAll(['department', 'volunteers', 'templateId']));
      allow update: if isAdminSession(request.resource.data._sessionId)
                    || (isFacultySession(request.resource.data._sessionId)
                        && resource.data.department == facultyDepartment(request.resource.data._sessionId)
                        && request.resource.data.department == resource.data.department);
      allow delete: if false;
    }

    match /pre_registrations/{docId} {
      allow read: if true;
      allow create, update: if isAdminSession(request.resource.data._sessionId)
                            && request.resource.data.keys().hasAll(['alumniName']);
      allow delete: if false;
    }

    match /event_registrations/{docId} {
      allow read: if true;
      allow create: if isAdminSession(request.resource.data._sessionId)
                    || isFacultySession(request.resource.data._sessionId)
                    || (isValidSession(request.resource.data._sessionId)
                        && get(sessionPath(request.resource.data._sessionId)).data.role == 'student_volunteer'
                        && request.resource.data.createdByUserId == get(sessionPath(request.resource.data._sessionId)).data.userId
                        && request.resource.data.keys().hasAll(['alumniName', 'department', 'mobile', 'createdByUserId']));
      allow update: if isAdminSession(request.resource.data._sessionId)
                    || isFacultySession(request.resource.data._sessionId)
                    || (isValidSession(request.resource.data._sessionId)
                        && get(sessionPath(request.resource.data._sessionId)).data.role == 'student_volunteer');
      allow delete: if false;
    }

    match /legeci_expenses/{expenseId} {
      allow read: if true;
      allow create: if isAccountsWriter(request.resource.data._sessionId)
                    && request.resource.data.keys().hasAll(['title', 'amount', 'paidBy']);
      allow update: if isAccountsWriter(request.resource.data._sessionId);
      allow delete: if false;
    }

    match /legeci_settlements/{settlementId} {
      allow read: if true;
      allow create: if isAccountsWriter(request.resource.data._sessionId)
                    && request.resource.data.keys().hasAll(['payee', 'amount']);
      allow update: if isAccountsWriter(request.resource.data._sessionId);
      allow delete: if false;
    }
  }
}
